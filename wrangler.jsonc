{
  // Cloudflare 部署設定：純靜態資產（無 Worker main、無 Durable Objects）。
  // 部署：`pnpm build && npx wrangler deploy`（首次會引導登入 Cloudflare 帳號）。
  // 之後要接自訂網域：在下方加 "routes": [{ "pattern": "<domain>", "custom_domain": true }]
  // （前提：該 zone 已接入同一 Cloudflare 帳號，比照 super-reversi2 的做法）。
  "name": "zhangben",
  "workers_dev": true,
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./packages/client/dist",
    // SPA fallback：/#sync= deep link 與任何路徑都回 index.html
    "not_found_handling": "single-page-application"
  }
}
